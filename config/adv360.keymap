#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

// German layout aliases
#define DE_Y Z
#define DE_Z Y
#define DE_SS MINUS
#define DE_UDIA LBKT
#define DE_ODIA SEMI
#define DE_ADIA SQT
#define DE_ACUT EQUAL
#define DE_PLUS RBKT
#define DE_HASH NUHS
#define DE_LABK NUBS
#define DE_MINS SLASH
#define DE_CIRC GRAVE

#define DE_DEG LS(DE_CIRC)
#define DE_EXLM LS(N1)
#define DE_DQUO LS(N2)
#define DE_DLR LS(N4)
#define DE_PERC LS(N5)
#define DE_AMPR LS(N6)
#define DE_SLSH LS(N7)
#define DE_LPRN LS(N8)
#define DE_RPRN LS(N9)
#define DE_EQL LS(N0)
#define DE_QUES LS(DE_SS)
#define DE_GRV LS(DE_ACUT)
#define DE_ASTR LS(DE_PLUS)
#define DE_QUOT LS(DE_HASH)
#define DE_RABK LS(DE_LABK)
#define DE_SCLN LS(COMMA)
#define DE_COLN LS(DOT)
#define DE_UNDS LS(DE_MINS)

#define DE_AT RA(Q)
#define DE_LBRC RA(N8)
#define DE_RBRC RA(N9)
#define DE_LCBR RA(N7)
#define DE_RCBR RA(N0)
#define DE_BSLS RA(DE_SS)
#define DE_PIPE RA(DE_LABK)
#define DE_TILD RA(DE_PLUS)

#define BASE_LINUX 0
#define BASE_MAC 1
#define SYM_LINUX 2
#define SYM_MAC 3
#define NAV 4
#define MOD 5

/ {
    macros {
        // Switch to Linux BT profile + layer
        linux_mode: linux_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to BASE_LINUX>;
        };
        // Switch to Mac BT profile + layer
        mac_mode: mac_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to BASE_MAC>;
        };
    };

    behaviors {
        td_cpc: tap_dance_copy_paste_cut {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(C)>, <&kp LC(X)>, <&kp LC(V)>;
        };
        td_cpc_mac: tap_dance_copy_paste_cut_mac {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(C)>, <&kp LG(X)>, <&kp LG(V)>;
        };
        ht_ue: hold_tap_ue {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_linux {
            display-name = "Linux";
            bindings = <
                &kp ESC   &kp N1 &kp N2   &kp N3      &kp N4      &kp N5 &tog MOD                                                                     &mo MOD &kp N6 &kp N7 &kp N8    &kp N9 &kp N0    &kp BSPC
                &kp TAB   &kp K  &kp DOT  &kp O       &kp COMMA   &kp DE_Y &none                                                                      &none   &kp V  &kp G  &kp C     &kp L  &kp DE_SS &kp DE_Z
                &mo SYM_LINUX &kp H &kp A &kp E       &kp I       &kp U  &none           &kp LCTRL &kp LALT  &kp LGUI  &kp RCTRL                      &none   &kp D  &kp T  &kp R     &kp N  &kp S     &kp F
                &kp LSHFT &kp X  &kp Q    &ht_ue LS(DE_ADIA) DE_ADIA &ht_ue LS(DE_UDIA) DE_UDIA &ht_ue LS(DE_ODIA) DE_ODIA      &kp HOME  &kp PG_UP                                 &kp B  &kp P  &kp W     &kp M  &kp J     &kp RSHFT
                &mo NAV   &none  &none    &none       &none                     &kp SPACE &td_cpc  &kp END   &kp PG_DN &kp BSPC  &kp ENTER                    &none  &none     &none  &none     &mo NAV
            >;
        };

        base_mac {
            display-name = "Mac";
            bindings = <
                &kp ESC   &kp N1 &kp N2   &kp N3      &kp N4      &kp N5 &tog MOD                                                                     &mo MOD &kp N6 &kp N7 &kp N8    &kp N9 &kp N0    &kp BSPC
                &kp TAB   &kp K  &kp DOT  &kp O       &kp COMMA   &kp DE_Y &none                                                                      &none   &kp V  &kp G  &kp C     &kp L  &kp DE_SS &kp DE_Z
                &mo SYM_MAC &kp H &kp A   &kp E       &kp I       &kp U  &none           &kp LCTRL &kp LALT  &kp LGUI  &kp RCTRL                      &none   &kp D  &kp T  &kp R     &kp N  &kp S     &kp F
                &kp LSHFT &kp X  &kp Q    &ht_ue LS(DE_ADIA) DE_ADIA &ht_ue LS(DE_UDIA) DE_UDIA &ht_ue LS(DE_ODIA) DE_ODIA      &kp HOME  &kp PG_UP                                 &kp B  &kp P  &kp W     &kp M  &kp J     &kp RSHFT
                &mo NAV   &none  &none    &none       &none                     &kp SPACE &td_cpc_mac &kp END &kp PG_DN &kp BSPC  &kp ENTER                   &none  &none     &none  &none     &mo NAV
            >;
        };

        sym_linux {
            display-name = "Sym";
            bindings = <
                &kp ESC   &kp F1      &kp F2      &kp F3      &kp F4      &kp F5 &trans                                                               &trans &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp BSPC
                &kp TAB   &trans      &kp DE_UNDS &kp DE_LBRC &kp DE_RBRC &kp DE_DEG &none                                                            &none  &kp DE_EXLM &kp DE_LABK &kp DE_RABK &kp DE_EQL  &kp DE_AMPR &kp DE_ACUT
                &trans    &kp DE_BSLS &kp DE_SLSH &kp DE_LCBR &kp DE_RCBR &kp DE_ASTR &none       &trans    &trans    &trans    &trans               &none  &kp DE_QUES &kp DE_LPRN &kp DE_RPRN &kp DE_MINS &kp DE_COLN &kp DE_AT
                &kp LSHFT &kp DE_HASH &kp DE_DLR  &kp DE_PIPE &kp DE_TILD &kp DE_GRV                        &trans    &trans                                &kp DE_PLUS &kp DE_PERC &kp DE_DQUO &kp DE_QUOT &kp DE_SCLN &kp RSHFT
                &trans    &trans      &trans      &trans      &trans                      &trans  &td_cpc   &trans    &trans    &trans &trans                           &trans      &trans      &trans      &trans      &trans
            >;
        };

        sym_mac {
            display-name = "SymM";
            bindings = <
                &kp ESC   &kp F1      &kp F2      &kp F3      &kp F4      &kp F5 &trans                                                               &trans &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp BSPC
                &kp TAB   &trans      &kp DE_UNDS &kp DE_LBRC &kp DE_RBRC &kp DE_DEG &none                                                            &none  &kp DE_EXLM &kp DE_LABK &kp DE_RABK &kp DE_EQL  &kp DE_AMPR &kp DE_ACUT
                &trans    &kp DE_BSLS &kp DE_SLSH &kp DE_LCBR &kp DE_RCBR &kp DE_ASTR &none       &trans    &trans    &trans    &trans               &none  &kp DE_QUES &kp DE_LPRN &kp DE_RPRN &kp DE_MINS &kp DE_COLN &kp DE_AT
                &kp LSHFT &kp DE_HASH &kp DE_DLR  &kp DE_PIPE &kp DE_TILD &kp DE_GRV                        &trans    &trans                                &kp DE_PLUS &kp DE_PERC &kp DE_DQUO &kp DE_QUOT &kp DE_SCLN &kp RSHFT
                &trans    &trans      &trans      &trans      &trans                      &trans  &td_cpc_mac &trans  &trans    &trans &trans                           &trans      &trans      &trans      &trans      &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp ESC   &kp F11     &kp F12  &kp F3   &kp F4    &kp F5 &trans                                                                       &trans &kp F6          &kp F7 &kp F8 &kp F9    &kp F10      &kp BSPC
                &kp TAB   &kp PG_UP   &kp BSPC &kp UP   &kp DEL   &kp PG_DN &none                                                                     &none  &kp KP_SLASH    &kp N7 &kp N8 &kp N9    &kp KP_MINUS &rgb_ug RGB_TOG
                &trans    &kp HOME    &kp LEFT &kp DOWN &kp RIGHT &kp END &none         &trans    &trans    &trans    &trans                         &none  &kp KP_ASTERISK &kp N4 &kp N5 &kp N6    &kp KP_PLUS  &trans
                &kp LSHFT &kp ESC     &kp TAB  &kp INS  &kp ENTER &kp LC(DE_Z)                    &trans    &trans                                          &kp N0          &kp N1 &kp N2 &kp N3    &kp KP_DOT   &kp RSHFT
                &trans    &trans      &trans   &trans   &trans                    &kp N0 &trans   &trans    &trans    &trans    &trans                                      &trans &trans &trans    &trans       &trans
            >;
        };

        mod_layer {
            display-name = "Mod";
            bindings = <
                &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                          &trans      &none &none      &none      &none &none &none
                &none &linux_mode  &mac_mode    &none        &none        &none        &bootloader                                                    &bootloader &none &none      &none      &none &none &none
                &none &none        &none        &none        &none        &none        &none             &none &none &bt BT_CLR &none                 &none       &none &none      &none      &none &none &none
                &none &none        &none        &none        &none        &none                                &none &none                                        &none &none      &none      &none &none &none
                &none &none        &none        &none        &none                               &none &none   &none &none      &bl BL_TOG &rgb_ug RGB_TOG                  &bl BL_INC &bl BL_DEC &none &none &none
            >;
        };
    };
};
